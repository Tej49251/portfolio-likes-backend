# Backend Environment Variables — Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.

# PostgreSQL connection string from Neon (use the pooled endpoint URL)
# Format: postgresql://user:password@ep-xxx.pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@your-neon-host/neondb?sslmode=require

# The exact origin of your deployed Firebase portfolio (no trailing slash)
ALLOWED_ORIGIN=https://portfolio-tejas-4c9f7.web.app

# Admin secret — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters. Keep this identical on Render and in local-admin-server/.env
ADMIN_SECRET=your_strong_random_secret_here_at_least_32_chars

# Node environment (set to 'production' on Render)
NODE_ENV=production

# Port is set automatically by Render; set for local development
PORT=3000
