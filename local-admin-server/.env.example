# Local Admin Server — Environment Variables
# Copy this file to local-admin-server/.env and fill in the values.
# NEVER commit local-admin-server/.env to Git.

# The admin secret — must match ADMIN_SECRET on Render exactly.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=your_admin_secret_here_at_least_32_chars

# Your Render service URL (no trailing slash)
RENDER_API_URL=https://your-app-name.onrender.com

# Port for the local dashboard (default 3001)
DASHBOARD_PORT=3001
